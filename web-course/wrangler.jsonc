{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "wispy-wildflower-4a02",
  "account_id": "0a4d6a09311db6a9c571137c559e8669",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{"pattern": "ainarium.com", "custom_domain": true}],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["feedback@ainarium.ai"]}],
  "vars": {"FEEDBACK_FROM": "feedback@ainarium.ai"},
  "ratelimits": [{
    "name": "FEEDBACK_RATE_LIMITER",
    "namespace_id": "10431031",
    "simple": {"limit": 5, "period": 60}
  }],
  "observability": {"enabled": true}
}
